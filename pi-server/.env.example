# Copy this file to .env and fill it in.

# Your nvapi- key from build.nvidia.com -> Settings -> API Keys
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# nl = Dutch, en = English, multi = auto detect
LANGUAGE=nl

# The name of the Nest Mini exactly as shown in the Google Home app
NEST_NAME=Nest Mini
# Optional: the Nest Mini's IP address (Google Home app -> device -> settings -> device info)
NEST_IP=

# The Pi's address on your home Wi-Fi (NOT the Tailscale one). The Nest downloads replies from here.
PUBLIC_URL=http://192.168.1.10:8790
PORT=8790
UDP_PORT=8791

# Any secret word. Put the same one in the board's secrets.h
JARVIS_KEY=change-me

# Home Assistant: profile (your name, bottom left) -> Security -> Long-lived access tokens -> Create token
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
# Device types Jarvis may control
HA_DOMAINS=light,switch,scene,fan,climate,input_boolean

# Music AI taste server (on this Pi) for "speel mijn gsm hier verder"
MUSIC_AI_URL=http://127.0.0.1:8765

# Storm Study: your Jarvis code from study.ictstorm.com (starts with jv_). Never put it on GitHub.
STUDY_URL=https://study.ictstorm.com
STUDY_JARVIS_TOKEN=

# School buddy (Jarvis School app). Defaults are fine for LAB Sint-Amands, Human Body project.
SCHOOL_SITE=https://sites.google.com/labonderwijs.be/humanbody/homepage
SCHOOL_ROUTE=z
SCHOOL_WEEK1=2026-11-09
SCHOOL_REMIND=19:00
SCHOOL_PLANNER_REMIND=18:00
# Google Drive saver (school-drive/README.md). The secret is made by the installer.
DRIVE_SCRIPT_URL=
DRIVE_SECRET=
