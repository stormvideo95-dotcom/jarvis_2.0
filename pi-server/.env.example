# Copy this file to .env and fill it in.

# Your nvapi- key from build.nvidia.com -> Settings -> API Keys
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct

# nl = Dutch, en = English, multi = auto detect
LANGUAGE=nl

# The name of the Nest Mini exactly as shown in the Google Home app
NEST_NAME=Nest Mini
# Optional: the Nest Mini's IP address (Google Home app -> device -> settings -> device info)
NEST_IP=

# The Pi's address on your home Wi-Fi (NOT the Tailscale one). The Nest downloads replies from here.
PUBLIC_URL=http://192.168.1.10:8790
PORT=8790

# Any secret word. Put the same one in the board's secrets.h
JARVIS_KEY=change-me
